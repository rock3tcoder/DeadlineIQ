# Scraper environment variables — copy to .env and fill in
# These will be set as Railway environment variables in production

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=sk-your-openai-key
RESEND_API_KEY=re_your-resend-key
RESEND_FROM_EMAIL=alerts@deadlineiq.com
APP_URL=https://deadlineiq.com

# Mobile push notifications (optional — push is skipped when unset)
# Paste the raw JSON of a Firebase service account key:
# Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"...","token_uri":"https://oauth2.googleapis.com/token"}
